{
  "name": "traffic-simulator",
  "version": "1.0.0",
  "description": "Traffic simulator for Course Platform API using Apache Bench",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run docker:build && npm run docker:run",
    "start:local": "ts-node src/index.ts",
    "dev": "ts-node src/index.ts",
    "docker:build": "docker build -t traffic-simulator:latest .",
    "docker:run": "docker run --rm --add-host=host.docker.internal:host-gateway traffic-simulator:latest --url http://host.docker.internal:3000 --load low",
    "docker:run:high": "docker run --rm --add-host=host.docker.internal:host-gateway traffic-simulator:latest --url http://host.docker.internal:3000 --load high",
    "docker:run:help": "docker run --rm traffic-simulator:latest --help"
  },
  "keywords": [
    "traffic",
    "load-testing",
    "apache-bench"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.0",
    "commander": "^11.0.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.5.0",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
}
