{
  "name": "service-template",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc",
    "start": "prisma db push --config prisma.config.ts && node dist/index.js",
    "postinstall": "prisma generate",
    "dev": "npx prisma db push && nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "test": "npx jest --runInBand",
    "test:watch": "npx jest --watch",
    "test:unit": "npx jest --config jest.unit.config.js",
    "test:e2e": "npx jest --testPathPatterns=\\.e2e\\.test\\.ts$"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^5.21.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.22.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.11.0",
    "prom-client": "^15.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.31",
    "@types/pg": "^8.10.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "prisma": "^5.21.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
